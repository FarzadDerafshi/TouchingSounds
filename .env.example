# TouchingSounds settings. Copy this file to .env (same folder as
# docker-compose.yml) and fill it in. .env is git-ignored, so your addresses
# stay on your machine.

# Your speaker(s), comma-separated IP addresses (port 8090 must be reachable
# from the server). Only read on the very first start, to create
# data/devices.json; after that you add and remove speakers in the app.
# The first one is the primary speaker.
# Add ":fresh" to a speaker whose source list may be replaced outright, e.g.
# a second-hand one still carrying the previous owner's accounts.
BOSE_DEVICES=192.168.1.20

# The address the SPEAKERS use to reach this server (not localhost: the
# speaker must be able to open it). Usually the LAN IP of the machine running
# Docker, port 8000.
BOSE_SERVER_URL=http://192.168.1.10:8000

# Optional: the subnets "Add a speaker" searches, comma-separated.
# Default: the /24 of every known speaker.
# TS_SCAN_SUBNETS=192.168.1.0/24

# Optional: the speaker's HTTP port. Default 8090.
# BOSE_PORT=8090

# Optional: default stations for preset buttons 1-6, used until you save a
# preset from the app. Direct stream URLs; https:// and HLS (.m3u8) streams are
# re-streamed by the server. Find streams at https://www.radio-browser.info
# PRESET_1_URL=http://example-radio.com/stream.mp3
# PRESET_1_NAME=My Station
